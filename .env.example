# === Vercel Environment Variables ===
# Isi nilai-nilai ini di dashboard Vercel:
#   Project → Settings → Environment Variables → Add

# Database PostgreSQL (Vercel tidak mendukung MySQL).
# Contoh dari Neon:  postgresql://user:password@ep-xxx.region.aws.neon.tech/sales_auto_analytics?sslmode=require
# PostgreSQL juga perlu didukung di dev lokal (Laragon / standalone).
DATABASE_URL="postgresql://user:password@host:5432/sales_auto_analytics"

# Secret untuk JWT — ganti dengan string acak yang panjang.
JWT_SECRET="ganti-dengan-secret-panjang-acak"
