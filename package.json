{
  "name": "sales-auto-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Sales Auto Analytics — POS & laporan otomatis untuk UMKM (deployable ke Vercel)",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend install --no-audit --no-fund && npm --prefix frontend run build",
    "start": "node backend/src/index.js",
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "pdfmake": "^0.2.17",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  }
}
