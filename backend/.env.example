# Database PostgreSQL (dev lokal). Vercel tidak mendukung MySQL.
# Gunakan Postgres lokal (Laragon) atau URL dari Neon.
# Contoh Neon:  postgresql://user:password@ep-xxx.region.aws.neon.tech/sales_auto_analytics?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/sales_auto_analytics"

# Secret untuk JWT — ganti dengan string acak yang panjang.
JWT_SECRET="ganti-dengan-secret-panjang-acak"

PORT=5001
